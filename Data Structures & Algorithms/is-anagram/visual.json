  "code": "class Solution:\n    def isAnagram(self, s: str, t: str) -> bool:\n\n        if len(s) != len(t):\n            return False\n\n        S, T = {}, {}\n\n        for i in range(len(t)):\n            S[s[i]] = 1 + S.get(s[i], 0)\n            T[t[i]] = 1 + T.get(t[i], 0)\n\n        return S == T",
